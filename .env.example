# URL of the Python cursor_openai_bridge that this Java relay's Chromium tab loads.
BRIDGE_URL=http://127.0.0.1:8787/
# Must match cursor_openai_bridge's RELAY_TOKEN.
RELAY_TOKEN=change-me-shared-with-python-bridge
# Bearer token this Java gateway requires from local Continue clients.
BEARER_TOKEN=change-me-to-a-long-secret
RELAY_HEADLESS=false
PLAYWRIGHT_BROWSERS_PATH=C:\browser\ms-playwright
BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
